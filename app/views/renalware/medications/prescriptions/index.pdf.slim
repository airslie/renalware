html
  meta content=("text/html; charset=UTF-8") http-equiv="Content-Type" /
  meta charset="utf-8" /

  head
    = wicked_pdf_stylesheet_link_tag "renalware/medications_pdf"

  heading
    .our-ref= "RW ref: #{presenter.patient.hospital_identifier}"

    span.logo= image_tag(wicked_pdf_asset_base64("renalware/NHS-Black.jpg"), width: 50)

  main.medications-list
    h1= title
    = "As at #{l(Time.zone.now)}"

    - with_format(:html) do
      = render "patient_details", patient: presenter.patient

    - if Renalware.config.enable_allergies
      section
        h3 Allergies
        - allergies = Renalware::Clinical.cast_patient(presenter.patient).allergies
        - if allergies.any?
          ul.allergies
            - allergies.each do |allergy|
              li= allergy.description
        - else
          p None

    section.review
      = render Renalware::Medications::LatestReviewComponent.new(patient: presenter.patient)

    - if local_assigns.fetch(:render_current_medications_section, true)
      section.prescriptions
        - with_format(:html) do
          = render "renalware/medications/prescriptions/current",
                  prescriptions: presenter.current_standard_prescriptions,
                  recently_changed: presenter.recently_changed_prescriptions

    section.prescriptions
      - with_format(:html) do
        = render "renalware/medications/prescriptions/current_hd",
                prescriptions: presenter.current_hd_prescriptions,
                recently_changed: presenter.recently_changed_prescriptions,
                render_if_blank: local_assigns.fetch(:render_empty_hd_prescriptions_section, false)

    - if Renalware.config.outpatient_prescription_administration_enabled
      section.prescriptions
        - with_format(:html) do
          = render "renalware/medications/prescriptions/current_outpatient",
                  prescriptions: presenter.current_outpatient_prescriptions,
                  recently_changed: presenter.recently_changed_prescriptions,
                  render_if_blank: local_assigns.fetch(:render_empty_outpatient_prescriptions_section, false)

    section.prescriptions
      - with_format(:html) do
        = render "renalware/medications/prescriptions/recently_stopped",
                prescriptions: presenter.recently_stopped_prescriptions

    section.sign-off
      div
        .sign-off_title Signature
        .sign-off_space
      div
        .sign-off_title Professional reg number
        .sign-off_space
      div
        .sign-off_title Date
        .sign-off_space
